{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command",
          "command": "$CLAUDE_PROJECT_DIR/scripts/guard-commit.sh" }]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [{ "type": "command",
          "command": "$CLAUDE_PROJECT_DIR/scripts/guard-money-path.sh" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command",
          "command": "echo \"hooks-alive $(date -u +%FT%TZ)\" >> /tmp/paperhorse-hooks.log" }]
      }
    ]
  }
}
