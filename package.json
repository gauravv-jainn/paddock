{
  "name": "paperhorse",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "tsx watch src/worker/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:settlement": "vitest run src/modules/settlement tests/golden tests/consensus tests/metamorphic --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test:metamorphic": "vitest run --config vitest.metamorphic.config.ts",
    "typecheck:metamorphic": "tsc --noEmit -p tsconfig.metamorphic.json",
    "mutation": "pnpm mutation:a && pnpm mutation:b",
    "mutation:a": "stryker run stryker.gate-a.json",
    "mutation:b": "stryker run stryker.gate-b.json",
    "verify": "./scripts/verify.sh",
    "verify:fast": "./scripts/verify.sh --fast"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.4",
    "next": "^15.1.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitest/coverage-v8": "^3.0.4",
    "axe-core": "^4.12.1",
    "drizzle-kit": "^0.30.2",
    "eslint": "^9.19.0",
    "fast-check": "^4.9.0",
    "globals": "^15.14.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.22.0",
    "vite": "7.3.6",
    "vitest": "^3.0.4"
  }
}
