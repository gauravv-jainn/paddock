# Copy to .env.local and adjust. .env* is gitignored.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Matches docker-compose.yml. Port 5433 on the host so a PostgreSQL already
# listening on 5432 is left alone.
DATABASE_URL=postgres://paperhorse:paperhorse@localhost:5433/paperhorse_dev

# Used only by the database-backed test suites, which TRUNCATE the tables they
# touch. It must never point at a database holding data you care about — the
# suites refuse to run at all when it is unset, rather than falling back to
# DATABASE_URL.
TEST_DATABASE_URL=postgres://paperhorse:paperhorse@localhost:5433/paperhorse_test

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------
# HMAC key for sessions.ip_hash. With this unset, ip_hash is stored as NULL —
# a plain hash of an IPv4 address is reversible by brute force in seconds, so
# storing nothing is the safer default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_IP_PEPPER=

# ---------------------------------------------------------------------------
# Archive provider
# ---------------------------------------------------------------------------
# Directory holding <REGION>/<YYYY-MM-DD>.json historical day files. The format
# is documented in src/modules/providers/archive/README.md. These files are
# assembled by hand from real historical results; nothing generates them.
ARCHIVE_ROOT=./archive
